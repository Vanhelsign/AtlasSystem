# Copia este archivo como .env y completa los valores. .env está en .gitignore: nunca lo subas al repositorio.
# Sin SMTP_HOST, el servidor trabaja en modo simulado: guarda cada correo como .eml en data/correos/
# y lo registra como "pendiente". No se envía nada.

# Servidor SMTP del proveedor de correo.
SMTP_HOST=
# 587 con STARTTLS (SMTP_SECURE=false) o 465 con TLS directo (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente que verá el cliente, por ejemplo: ATLAS CRM <no-responder@ejemplo.com>
CORREO_REMITENTE=

# URL pública de la aplicación. El enlace "Crear mi contraseña" del correo apunta aquí
# (APP_URL/#crear-contrasena=...). Con localhost solo funciona en la máquina que corre la app.
APP_URL=http://localhost:5173

# Opcional: vigencia del enlace para crear contraseña, en horas (por defecto 48),
# y enlaces no válidos permitidos por IP en 15 minutos (por defecto 10).
# ATLAS_ENLACE_VIGENCIA_HORAS=48
# ATLAS_ENLACE_MAX_IP=10

# Opcional: tiempo máximo de espera de cada envío, en milisegundos (por defecto 15000).
# CORREO_TIEMPO_MAX_MS=15000
