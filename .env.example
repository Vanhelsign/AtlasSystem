# Copia este archivo como .env y completa los valores. .env está en .gitignore: nunca lo subas al repositorio.
# Sin SMTP_HOST, el servidor trabaja en modo simulado: guarda cada correo como .eml en data/correos/
# y lo registra como "pendiente". No se envía nada.

# Servidor SMTP del proveedor de correo.
SMTP_HOST=
# 587 con STARTTLS (SMTP_SECURE=false) o 465 con TLS directo (SMTP_SECURE=true).
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Remitente que verá el cliente, por ejemplo: ATLAS CRM <no-responder@ejemplo.com>
CORREO_REMITENTE=

# URL pública de la aplicación. El enlace "Crear mi contraseña" del correo apunta aquí
# (APP_URL/#crear-contrasena=...). Con localhost solo funciona en la máquina que corre la app.
APP_URL=http://localhost:5173

# Opcional: vigencia del enlace para crear contraseña, en horas (por defecto 48),
# y enlaces no válidos permitidos por IP en 15 minutos (por defecto 10).
# ATLAS_ENLACE_VIGENCIA_HORAS=48
# ATLAS_ENLACE_MAX_IP=10

# Opcional: tiempo máximo de espera de cada envío, en milisegundos (por defecto 15000).
# CORREO_TIEMPO_MAX_MS=15000

# Firma y pago. No configurar cuentas bancarias ficticias como si fueran reales.
# Plazo desde la aceptación: días completos de 24 h, con fecha/hora del servidor en UTC.
ATLAS_PAGO_PLAZO_DIAS=7
# Texto libre con las instrucciones reales de la organización; comillas para espacios/saltos.
# Si queda vacío, la orden muestra "Instrucciones de pago pendientes".
# Se copia al emitir cada orden; un cambio aquí aplica a nuevas órdenes, no reescribe las anteriores.
ATLAS_PAGO_INSTRUCCIONES=
# Datos opcionales de cobro; se conservan con cada orden nueva. Completar solo con datos reales.
ATLAS_PAGO_BENEFICIARIO=
ATLAS_PAGO_BANCO=
ATLAS_PAGO_CLABE=
ATLAS_PAGO_CUENTA=
ATLAS_PAGO_REFERENCIA=

# Pago simulado: activo por defecto en desarrollo, incluso sin .env.
# Estas líneas son opcionales; no hace falta configurarlas para ver el botón.
# Para desactivarlo, usa false en las banderas. En producción el backend siempre
# lo rechaza y npm run build nunca habilita el botón.
NODE_ENV=development
ATLAS_PAGO_SIMULADO=true
VITE_ATLAS_PAGO_SIMULADO=true

# Fotografías privadas de instalación. Por defecto: evidencias/ junto a la base SQLite.
# No colocar esta carpeta dentro de public/ ni publicarla mediante un servidor estático.
ATLAS_EVIDENCIAS_DIR=
